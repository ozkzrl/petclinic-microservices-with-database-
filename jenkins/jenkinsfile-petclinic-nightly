pipeline {pipeline {
    agent any
    environment {
        APP_NAME = "petclinic"
        APP_REPO_NAME = "ondia-repo/${APP_NAME}-app-dev"
        AWS_REGION = "us-east-1"
        ANS_KEYPAIR = "petclinic-${APP_NAME}-dev-${BUILD_NUMBER}.key"
        ANSIBLE_PRIVATE_KEY_FILE = "${WORKSPACE}/${ANS_KEYPAIR}"
        ANSIBLE_HOST_KEY_CHECKING = "False"
    }

    stages {

        stage('Set AWS Credentials') {
            steps {
                withCredentials([[$class: 'UsernamePasswordMultiBinding', 
                                  credentialsId: 'aws-petclinic-creds', 
                                  usernameVariable: 'AWS_ACCESS_KEY_ID', 
                                  passwordVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    sh 'aws sts get-caller-identity'
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    }
                }
            }
        }

        stage('Create ECR Repo') {
            steps {
                withCredentials([[$class: 'UsernamePasswordMultiBinding', 
                                  credentialsId: 'aws-petclinic-creds', 
                                  usernameVariable: 'AWS_ACCESS_KEY_ID', 
                                  passwordVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    sh '''
                        aws ecr describe-repositories --region ${AWS_REGION} --repository-name ${APP_REPO_NAME} || \
                        aws ecr create-repository \
                            --repository-name ${APP_REPO_NAME} \
                            --image-scanning-configuration scanOnPush=true \
                            --image-tag-mutability MUTABLE \
                            --region ${AWS_REGION}
                    '''
                }
            }
        }

        stage('Package Application') {
            steps {
                echo 'Packaging the app into jars with maven'
                sh ". ./jenkins/package-with-maven-container.sh"
            }
        }

        stage('Prepare Docker Image Tags') {
            steps {
                echo 'Preparing Tags for Docker Images'
                script {
                    def services = [
                        "spring-petclinic-admin-server",
                        "spring-petclinic-api-gateway",
                        "spring-petclinic-config-server",
                        "spring-petclinic-customers-service",
                        "spring-petclinic-discovery-server",
                        "spring-petclinic-hystrix-dashboard",
                        "spring-petclinic-vets-service",
                        "spring-petclinic-visits-service"
                    ]

                    services.each { svc ->
                        def version = sh(script: ". ${WORKSPACE}/${svc}/target/maven-archiver/pom.properties && echo \$version", returnStdout:true).trim()
                        env["IMAGE_TAG_${svc.toUpperCase().replace("-", "_")}"] = "${ECR_REGISTRY}/${APP_REPO_NAME}:${svc.split('-')[-1]}-v${version}-b${BUILD_NUMBER}"
                    }

                    env.IMAGE_TAG_GRAFANA_SERVICE = "${ECR_REGISTRY}/${APP_REPO_NAME}:grafana-service"
                    env.IMAGE_TAG_PROMETHEUS_SERVICE = "${ECR_REGISTRY}/${APP_REPO_NAME}:prometheus-service"
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                echo 'Building Docker Images'
                sh ". ./jenkins/build-dev-docker-images-for-ecr.sh"
                sh 'docker image ls'
            }
        }

        stage('Push Images to ECR') {
            steps {
                echo 'Pushing Docker Images to ECR'
                sh ". ./jenkins/push-dev-docker-images-to-ecr.sh"
            }
        }

        stage('Create Key Pair for Ansible') {
            steps {
                withCredentials([[$class: 'UsernamePasswordMultiBinding', 
                                  credentialsId: 'aws-petclinic-creds', 
                                  usernameVariable: 'AWS_ACCESS_KEY_ID', 
                                  passwordVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                    sh "aws ec2 create-key-pair --region ${AWS_REGION} --key-name ${ANS_KEYPAIR} --query KeyMaterial --output text > ${ANS_KEYPAIR}"
                    sh "chmod 400 ${ANS_KEYPAIR}"
                }
            }
        }

        stage('Create QA Automation Infrastructure') {
            steps {
                echo 'Creating QA Automation Infrastructure'
                sh """
                    cd infrastructure/dev-k8s-terraform
                    sed -i "s/clarus/$ANS_KEYPAIR/g" main.tf
                    terraform init
                    terraform apply -auto-approve -no-color
                """
                script {
                    env.MASTER_INSTANCE_ID = sh(
                        script: 'aws ec2 describe-instances --filters "Name=tag-value,Values=master" "Name=tag-value,Values=tera-kube-ans" "Name=instance-state-name,Values=running" --query "Reservations[*].Instances[*].[InstanceId]" --output text',
                        returnStdout:true
                    ).trim()
                    sh "aws ec2 wait instance-status-ok --instance-ids ${env.MASTER_INSTANCE_ID}"
                }
            }
        }

        stage('Setup Kubernetes Cluster') {
            steps {
                echo 'Setting up Kubernetes Cluster via Ansible'
                sh "ansible-playbook -i ./ansible/inventory/dev_stack_dynamic_inventory_aws_ec2.yaml ./ansible/playbooks/k8s_setup.yaml"
            }
        }

        stage('Deploy App on Kubernetes') {
            steps {
                echo 'Deploying App on Kubernetes'
                sh "envsubst < k8s/petclinic_chart/values-template.yaml > k8s/petclinic_chart/values.yaml"
                sh "sed -i s/HELM_VERSION/${BUILD_NUMBER}/ k8s/petclinic_chart/Chart.yaml"
                sh "helm repo add stable-petclinic s3://petclinic-helm-charts-ozkzrlgit/stable/myapp/"
                sh "helm package k8s/petclinic_chart"
                sh "helm s3 push --force petclinic_chart-${BUILD_NUMBER}.tgz stable-petclinic"
                sh "envsubst < ansible/playbooks/dev-petclinic-deploy-template > ansible/playbooks/dev-petclinic-deploy.yaml"
                sh "sleep 60"
                sh "ansible-playbook -i ./ansible/inventory/dev_stack_dynamic_inventory_aws_ec2.yaml ./ansible/playbooks/dev-petclinic-deploy.yaml"
            }
        }

        stage('Test Application Deployment') {
            steps {
                echo 'Testing Application Deployment'
                script {
                    env.MASTER_PUBLIC_IP = sh(
                        script: "aws ec2 describe-instances --region ${AWS_REGION} --filters Name=tag-value,Values=master Name=tag-value,Values=tera-kube-ans Name=instance-state-name,Values=running --query 'Reservations[*].Instances[*].[PublicIpAddress]' --output text",
                        returnStdout:true
                    ).trim()

                    while(true) {
                        try {
                            sh "curl -s ${MASTER_PUBLIC_IP}:30001"
                            echo "${APP_NAME} app is successfully deployed."
                            break
                        } catch(Exception e) {
                            echo "Could not connect to ${APP_NAME} app yet. Retrying in 5s..."
                            sleep(5)
                        }
                    }
                }
            }
        }

        stage('Run QA Automation Tests') {
            steps {
                echo 'Running Selenium Functional Tests'
                sh 'ansible-playbook -vvv --connection=local --inventory 127.0.0.1, --extra-vars "workspace=${WORKSPACE} master_public_ip=${MASTER_PUBLIC_IP}" ./ansible/playbooks/pb_run_selenium_jobs.yaml'
            }
        }
    }

    post {
        always {
            echo 'Cleaning up local Docker images'
            sh 'docker image prune -af'

            echo 'Deleting ECR Repository'
            withCredentials([[$class: 'UsernamePasswordMultiBinding', 
                              credentialsId: 'aws-petclinic-creds', 
                              usernameVariable: 'AWS_ACCESS_KEY_ID', 
                              passwordVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                sh "aws ecr delete-repository --repository-name ${APP_REPO_NAME} --region ${AWS_REGION} --force"
            }

            echo 'Tearing down Kubernetes Cluster'
            sh """
                cd infrastructure/dev-k8s-terraform
                terraform destroy -auto-approve -no-color
            """

            echo 'Deleting Key Pair'
            withCredentials([[$class: 'UsernamePasswordMultiBinding', 
                              credentialsId: 'aws-petclinic-creds', 
                              usernameVariable: 'AWS_ACCESS_KEY_ID', 
                              passwordVariable: 'AWS_SECRET_ACCESS_KEY']]) {
                sh "aws ec2 delete-key-pair --region ${AWS_REGION} --key-name ${ANS_KEYPAIR}"
                sh "rm -rf ${ANS_KEYPAIR}"
            }
        }
    }
}
